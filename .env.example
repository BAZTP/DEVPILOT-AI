# =============================================================================
# DevPilot AI — Variables de entorno de ejemplo
# Copia este archivo como .env y completa los valores reales
# NUNCA commits el archivo .env con valores reales
# =============================================================================

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="postgresql://devpilot:devpilot_secret@localhost:5432/devpilot_db"

# ─── API Backend (NestJS) ─────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ─── JWT / Sesiones ───────────────────────────────────────────────────────────
# Genera un secreto fuerte: openssl rand -hex 64
JWT_SECRET=reemplaza_con_un_secreto_fuerte_de_64_caracteres_minimo
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=reemplaza_con_otro_secreto_fuerte_para_refresh_tokens
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── GitHub OAuth App ─────────────────────────────────────────────────────────
# Crea tu OAuth App en: https://github.com/settings/developers
GITHUB_CLIENT_ID=tu_github_client_id_aqui
GITHUB_CLIENT_SECRET=tu_github_client_secret_aqui
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# ─── Workspace de proyectos ───────────────────────────────────────────────────
# Directorio donde se almacenan los archivos de proyectos (fuera del repositorio)
WORKSPACE_BASE_PATH=/tmp/devpilot-workspace

# ─── Cifrado de secretos de usuario ──────────────────────────────────────────
# Clave para cifrar API keys de modelos IA del usuario
# Genera con: openssl rand -hex 32
ENCRYPTION_KEY=reemplaza_con_clave_de_cifrado_de_32_bytes_en_hex

# ─── Ejecución en sandbox (Docker) ───────────────────────────────────────────
DOCKER_ENABLED=true
EXECUTION_TIMEOUT_SECONDS=30
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5

# ─── Configuración de CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── PostgreSQL directo (para Docker Compose) ────────────────────────────────
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_secret
POSTGRES_DB=devpilot_db
POSTGRES_PORT=5432
