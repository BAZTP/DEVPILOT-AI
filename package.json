{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevPilot AI — Entorno de desarrollo inteligente con IA",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @devpilot/database run generate",
    "db:migrate": "pnpm --filter @devpilot/database run migrate",
    "db:studio": "pnpm --filter @devpilot/database run studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "prisma"
  ],
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
